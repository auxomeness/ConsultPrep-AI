# Copy values into your local environment. Never commit a real key.
RADEON_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
RADEON_API_KEY=
RADEON_MODEL=
RADEON_TIMEOUT_MS=30000
RADEON_REASONING_EFFORT=low

# Philippine demo default is 911. Override only with a verified local emergency contact.
CONSULTPREP_EMERGENCY_NUMBER=911
CONSULTPREP_EMERGENCY_REGION=in the Philippines

# The smoke script requires this explicit opt-in and makes one chat request.
AMD_LIVE_SMOKE_CONFIRM=
