{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "api/**/*.ts",
    "auth/**/*.ts",
    "db/**/*.ts",
    "persistence/**/*.ts"
  ]
}
