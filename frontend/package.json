{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:ai": "npm --prefix ../packages/ai run build",
    "predev": "npm run build:ai",
    "dev": "node scripts/dev.mjs",
    "prebuild": "npm run build:ai",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "npm run build -- --webpack && playwright test"
  },
  "dependencies": {
    "@consultprep/ai": "file:../packages/ai",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
