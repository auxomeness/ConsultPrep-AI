# Reference inventory only. The repository has no root package/workspace, and
# these values are not all consumed by the current application.

# Next.js host (frontend currently runs without environment configuration)
APP_URL=http://localhost:3000

# Supabase: reserved for future authenticated server/API integration.
# The current frontend has no Supabase client and these values do not enable auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Keep this secret server-side only; do not set it in a browser environment.
# SUPABASE_SERVICE_ROLE_KEY=

# Direct PostgreSQL connection for local migrations / Drizzle configuration.
# No runtime database adapter currently consumes this value.
DATABASE_URL=

# Optional AMD Token Factory client settings used by packages/ai only.
# The standalone interactive intake currently uses local Qwen and does not call AMD.
RADEON_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
RADEON_API_KEY=
RADEON_MODEL=
RADEON_TIMEOUT_MS=30000
RADEON_REASONING_EFFORT=low

# Explicit opt-ins for scripts that make one live provider request.
AMD_LIVE_SMOKE_CONFIRM=
AMD_QA_DEMO_CONFIRM=
